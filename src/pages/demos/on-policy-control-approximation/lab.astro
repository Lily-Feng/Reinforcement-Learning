---
import { chapterUrl } from '../../../lib/url';
const backHref = chapterUrl('10-on-policy-control-approximation');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Eighteen interactive modules for on-policy control with function approximation, built around admission control for a GPU cluster." />
    <title>GPU admission control lab</title>
  </head>
  <body>
    <div class="lab" data-lab data-back={backHref}></div>
    <noscript>This lab needs JavaScript.</noscript>
    <script>
      import { boot } from '../../../demos/gpu-cluster/app/main';
      const root = document.querySelector<HTMLElement>('[data-lab]')!;
      boot(root);
      const back = root.dataset.back;
      const eyebrow = root.querySelector('.topbar .eyebrow');
      if (back && eyebrow) {
        const a = document.createElement('a');
        a.href = back;
        a.target = '_top';
        a.textContent = ' ← chapter';
        eyebrow.append(a);
      }
    </script>
    <style is:global>
      /* Token set shared with the function-approximation demos (baird.astro), plus lab-specific tokens. */
      :root {
        color-scheme: light;
        --bg: #f1f5f9; --surface: #ffffff; --inset: #f8fafc; --border: #cbd5e1; --grid: #e2e8f0;
        --text: #0f172a; --muted: #475569; --accent: #5b21b6; --accent-bg: #ede9fe; --danger: #b91c1c; --danger-bg: #fee2e2;
        --series-1: #2a78d6; --series-2: #eb6834; --series-3: #1baf7a; --series-4: #eda100; --series-5: #e87ba4; --series-6: #6250d6;
        --tier-0: #8a9bb0; --tier-1: #2a78d6; --tier-2: #1baf7a; --tier-3: #6250d6;
        --accept: #1baf7a; --reject: #c9d3e0; --ref: #b45309;
        --bucket-0: #9ec5f4; --bucket-1: #3987e5; --bucket-2: #184f95; --bucket-3: #0d366b;
        --seq-low: #eef4fd; --seq-high: #184f95;
        --div-low: #d95926; --div-mid: #f8fafc; --div-high: #2a78d6;
      }
      @media (prefers-color-scheme: dark) {
        :root:not([data-theme="light"]) {
          color-scheme: dark;
          --bg: #0f172a; --surface: #1e293b; --inset: #0f172a; --border: #475569; --grid: #334155;
          --text: #e2e8f0; --muted: #94a3b8; --accent: #c4b5fd; --accent-bg: #312e81; --danger: #fca5a5; --danger-bg: #7f1d1d;
          --series-1: #3987e5; --series-2: #d95926; --series-3: #199e70; --series-4: #c98500; --series-5: #d55181; --series-6: #9085e9;
          --tier-0: #94a3b8; --tier-1: #3987e5; --tier-2: #199e70; --tier-3: #9085e9;
          --accept: #199e70; --reject: #475569; --ref: #fbbf24;
          --bucket-0: #cde2fb; --bucket-1: #6da7ec; --bucket-2: #256abf; --bucket-3: #184f95;
          --seq-low: #13233c; --seq-high: #9ec5f4;
          --div-low: #d95926; --div-mid: #1e293b; --div-high: #3987e5;
        }
      }
      :root[data-theme="dark"] {
        color-scheme: dark;
        --bg: #0f172a; --surface: #1e293b; --inset: #0f172a; --border: #475569; --grid: #334155;
        --text: #e2e8f0; --muted: #94a3b8; --accent: #c4b5fd; --accent-bg: #312e81; --danger: #fca5a5; --danger-bg: #7f1d1d;
        --series-1: #3987e5; --series-2: #d95926; --series-3: #199e70; --series-4: #c98500; --series-5: #d55181; --series-6: #9085e9;
        --tier-0: #94a3b8; --tier-1: #3987e5; --tier-2: #199e70; --tier-3: #9085e9;
        --accept: #199e70; --reject: #475569; --ref: #fbbf24;
        --bucket-0: #cde2fb; --bucket-1: #6da7ec; --bucket-2: #256abf; --bucket-3: #184f95;
        --seq-low: #13233c; --seq-high: #9ec5f4;
        --div-low: #d95926; --div-mid: #1e293b; --div-high: #3987e5;
      }

      :root { font-family: ui-sans-serif, system-ui, sans-serif; line-height: 1.4; font-size: 14px; }
      * { box-sizing: border-box; }
      body { margin: 0; background: var(--bg); color: var(--text); }
      .lab { padding: .75rem; max-width: 1400px; margin: 0 auto; display: flex; flex-direction: column; gap: .6rem; }
      .lab.embed { padding: .5rem; }
      h1 { font-size: 1.3rem; line-height: 1.2; margin: .1rem 0 0; }
      h2 { font-size: 1.05rem; margin: 0; }
      h3 { font-size: .9rem; margin: 0; }
      p { margin: 0; }
      a { color: var(--accent); }
      .eyebrow { color: var(--accent); font-size: .7rem; text-transform: uppercase; letter-spacing: .07em; }
      .eyebrow a { text-transform: none; letter-spacing: 0; }
      .muted { color: var(--muted); }
      .hint { font-weight: 400; color: var(--muted); font-size: .75rem; }
      .lede { color: var(--muted); font-size: .88rem; max-width: 70rem; }
      .loading, .error { padding: 2rem; color: var(--muted); }
      .error { color: var(--danger); }

      .topbar { display: flex; justify-content: space-between; align-items: flex-end; gap: .5rem 1rem; flex-wrap: wrap; }
      .sections { display: flex; flex-wrap: wrap; gap: .25rem; }
      .sections a { font-size: .8rem; text-decoration: none; padding: .3rem .55rem; border-radius: 999px; border: 1px solid var(--border); color: var(--text); background: var(--surface); }
      .sections a.active, .sections a:hover { border-color: var(--accent); background: var(--accent-bg); }
      .toolbar { display: flex; justify-content: space-between; align-items: center; gap: .5rem; flex-wrap: wrap; }
      .toolbar-right { display: flex; align-items: center; gap: .5rem; margin-left: auto; }
      .config-summary { font-size: .72rem; color: var(--muted); font-variant-numeric: tabular-nums; }
      .tabs { display: flex; gap: .25rem; overflow-x: auto; max-width: 100%; scrollbar-width: thin; }
      .tab { white-space: nowrap; font-size: .8rem; text-decoration: none; color: var(--text); padding: .35rem .6rem; border-radius: 8px 8px 0 0; border: 1px solid var(--border); border-bottom-width: 3px; background: var(--surface); }
      .tab.active { border-bottom-color: var(--accent); background: var(--accent-bg); font-weight: 700; }
      .tab-id { font-size: .68rem; font-weight: 800; color: var(--accent); letter-spacing: .04em; }
      .drawer { position: relative; }
      .drawer[hidden] { display: none; }
      .drawer-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr)); gap: .4rem .9rem; }

      .home { display: flex; flex-direction: column; gap: 1rem; }
      .home-section { display: flex; flex-direction: column; gap: .4rem; }
      .home-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr)); gap: .5rem; }
      .home-card { display: flex; flex-direction: column; gap: .2rem; text-decoration: none; color: var(--text); background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: .6rem .75rem; }
      .home-card:hover { border-color: var(--accent); }
      .home-card .muted { font-size: .8rem; }

      .module { display: flex; flex-direction: column; gap: .6rem; }
      .mod-head { display: flex; flex-direction: column; gap: .2rem; }
      .mod-id { color: var(--accent); font-size: .8rem; font-weight: 800; letter-spacing: .05em; }
      .mod-grid { display: grid; grid-template-columns: 300px minmax(0, 1fr); gap: .6rem; align-items: start; }
      .controls, .panels { display: flex; flex-direction: column; gap: .6rem; min-width: 0; }
      .grid2 { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .6rem; }
      .grid3 { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .6rem; }
      .grid4 { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: .6rem; }
      .card { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: .6rem .75rem; display: flex; flex-direction: column; gap: .45rem; margin: 0; min-width: 0; }
      .card.note { font-size: .82rem; }
      .card.note ul { margin: 0; padding-left: 1.1rem; }

      label.ctl { display: block; font-weight: 600; font-size: .8rem; }
      label.ctl > span:first-child { margin-right: .3rem; }
      label.check { display: flex; gap: .4rem; align-items: center; font-size: .8rem; font-weight: 600; }
      output { float: right; font-variant-numeric: tabular-nums; color: var(--accent); font-weight: 600; }
      input[type=number], select { display: block; width: 100%; margin-top: .2rem; font: inherit; font-variant-numeric: tabular-nums; color: inherit; background: var(--inset); border: 1px solid var(--border); border-radius: 6px; padding: .25rem .4rem; }
      input[type=range] { display: block; width: 100%; accent-color: var(--accent); margin: .2rem 0 0; }
      button { font: inherit; font-weight: 600; color: var(--text); background: var(--inset); border: 1px solid var(--border); border-radius: 6px; padding: .4rem .7rem; cursor: pointer; }
      button:hover:not(:disabled) { border-color: var(--accent); }
      button:disabled { opacity: .45; cursor: not-allowed; }
      button.primary { background: var(--accent); color: var(--surface); border-color: var(--accent); }
      button[aria-pressed="true"] { background: var(--accent-bg); color: var(--text); border-color: var(--accent); }
      button.link { background: none; border: 0; padding: 0; color: var(--accent); font-weight: 500; text-decoration: underline; }
      button.big { font-size: 1rem; padding: .6rem 1rem; }
      :focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
      .buttons { display: flex; flex-wrap: wrap; gap: .4rem; }
      .runner { display: flex; flex-wrap: wrap; gap: .35rem; align-items: center; }
      .runner select { width: auto; margin: 0; }
      .seg { display: flex; flex-wrap: wrap; gap: .25rem; }
      .seg button { padding: .25rem .5rem; font-size: .78rem; }

      .observe { background: var(--surface); border: 1px solid var(--border); border-left: 4px solid var(--accent); border-radius: 10px; padding: .45rem .75rem; font-size: .85rem; }
      .observe summary { font-weight: 700; cursor: pointer; }
      .observe ul { margin: .3rem 0 0; padding-left: 1.1rem; display: flex; flex-direction: column; gap: .2rem; }
      .status { font-size: .85rem; }
      .kpis { display: grid; grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr)); gap: .4rem; }
      .kpi { background: var(--inset); border: 1px solid var(--grid); border-radius: 8px; padding: .35rem .5rem; display: flex; flex-direction: column; }
      .kpi span { font-size: .7rem; color: var(--muted); }
      .kpi strong { font-size: 1.05rem; font-variant-numeric: tabular-nums; }
      .kpi small { font-size: .68rem; color: var(--muted); }
      .legend { display: flex; flex-wrap: wrap; gap: .25rem .7rem; font-size: .75rem; color: var(--muted); }
      .legend i { display: inline-block; width: .9rem; height: .55rem; vertical-align: middle; margin-right: .25rem; border-radius: 2px; }
      canvas { display: block; width: 100%; height: 240px; touch-action: pan-y; }
      .readout { font-size: .75rem; color: var(--muted); font-variant-numeric: tabular-nums; min-height: 1.2em; }
      .table-scroll { overflow-x: auto; max-width: 100%; }
      table { border-collapse: collapse; font-variant-numeric: tabular-nums; font-size: .8rem; width: 100%; }
      th, td { padding: .25rem .4rem; text-align: right; white-space: nowrap; border-bottom: 1px solid var(--grid); }
      th { color: var(--muted); font-weight: 600; }
      td.l, th.l { text-align: left; }
      tr.hl td { background: var(--accent-bg); }
      code { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: .78rem; }
      .math { overflow-x: auto; }
      .progress { position: relative; height: 1.2rem; background: var(--inset); border: 1px solid var(--border); border-radius: 6px; overflow: hidden; }
      .progress[hidden] { display: none; }
      .progress-fill { height: 100%; width: 0; background: var(--accent-bg); transition: width 120ms linear; }
      .progress-label { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; font-size: .72rem; color: var(--text); }
      .badge { display: inline-block; font-size: .72rem; font-weight: 700; border-radius: 999px; padding: .1rem .5rem; border: 1px solid var(--border); }
      .badge.yes { border-color: var(--accept); color: var(--text); background: color-mix(in srgb, var(--accept) 22%, transparent); }
      .badge.no { border-color: var(--danger); color: var(--danger); background: var(--danger-bg); }
      .pill { font-size: .7rem; padding: .05rem .4rem; border-radius: 999px; background: var(--inset); border: 1px solid var(--grid); }

      @media (max-width: 760px) {
        .mod-grid, .grid2, .grid3, .grid4 { grid-template-columns: minmax(0, 1fr); }
        .lab { padding: .5rem 1rem; }
        .config-summary { display: none; }
      }
      @media (prefers-reduced-motion: reduce) {
        * { transition: none !important; }
      }
    </style>
  </body>
</html>
