---
import { demoUrl } from '../lib/url';

interface Simulation {
  title: string;
  description: string;
  chapter: string;
  demo: string;
  topic: string;
}

// Add future simulations here; the gallery layout expands automatically.
const simulations: Simulation[] = [
  {
    title: "Baird's counterexample",
    description: 'Step semi-gradient TD(0) one batch at a time, trace every δ and Δw, and watch linear weights diverge while every true value is 0.',
    chapter: 'function-approximation',
    demo: 'baird',
    topic: 'Function approximation',
  },
  {
    title: 'MCTS search lab',
    description: 'Grow a tree across repeated searches, trace rollout actions, and inspect UCT scores and every value backup.',
    chapter: 'planning-and-learning',
    demo: 'mcts',
    topic: 'Planning and learning',
  },
  {
    title: 'Dynamic programming',
    description: 'Step through value updates, inspect Bellman backups, and connect policy improvement to Python.',
    chapter: 'dynamic-programming',
    demo: 'gridworld',
    topic: 'Dynamic programming',
  },
  {
    title: 'Epsilon-greedy',
    description: 'Watch an agent balance exploration and exploitation across a five-armed bandit.',
    chapter: 'multi-armed-bandits',
    demo: 'epsilon-greedy',
    topic: 'Multi-armed bandits',
  },
  {
    title: 'From TD(0) to TD(1)',
    description: 'Race two n-step TD learners on the same random-walk episodes and see how n trades bias for variance.',
    chapter: 'n-step-and-eligibility-traces',
    demo: 'td0-to-td1',
    topic: 'n-step bootstrapping',
  },
];
---

<div class="simulation-gallery">
  {
    simulations.map((simulation) => (
      <a
        class="simulation-card"
        href={demoUrl(simulation.chapter, simulation.demo)}
        aria-label={`Open the ${simulation.title} simulation`}
      >
        <div class="simulation-thumbnail" aria-hidden="true">
          <svg viewBox="0 0 640 360" role="presentation">
            <defs>
              <linearGradient id={`gallery-background-${simulation.demo}`} x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="#101a33" />
                <stop offset="1" stop-color="#172b4d" />
              </linearGradient>
              <linearGradient id={`gallery-reward-${simulation.demo}`} x1="0" y1="1" x2="0" y2="0">
                <stop offset="0" stop-color="#67e8f9" />
                <stop offset="1" stop-color="#d9ff62" />
              </linearGradient>
            </defs>

            <rect width="640" height="360" rx="24" fill={`url(#gallery-background-${simulation.demo})`} />
            <circle cx="552" cy="62" r="96" fill="#d9ff62" opacity="0.08" />
            <circle cx="88" cy="322" r="118" fill="#67e8f9" opacity="0.07" />

            {simulation.demo === 'baird' ? (
              <g font-family="system-ui, sans-serif" text-anchor="middle">
                <text x="46" y="48" fill="#fca5a5" font-size="14" text-anchor="start">SEMI-GRADIENT TD(0) · TRUE V = 0</text>
                {[0, 1, 2, 3, 4].map((i) => (
                  <g>
                    <line x1={70 + i * 62} y1={112} x2={194} y2={250} stroke="#64748b" stroke-width="3" />
                    <circle cx={70 + i * 62} cy="98" r="24" fill={['#9ec5f4', '#6da7ec', '#3987e5', '#256abf', '#184f95'][i]} />
                  </g>
                ))}
                <path d="M226 262 C 290 230, 290 310, 226 288" fill="none" stroke="#64748b" stroke-width="3" />
                <circle cx="194" cy="272" r="32" fill="#0d366b" stroke="#cde2fb" stroke-width="2" />
                <text x="194" y="280" fill="#f8fafc" font-size="20" font-weight="700">s₆</text>
                <line x1="360" y1="292" x2="600" y2="292" stroke="#475569" stroke-width="2" />
                <line x1="360" y1="220" x2="600" y2="220" stroke="#94a3b8" stroke-width="2" stroke-dasharray="6 5" />
                <path d="M360 220 C 420 200, 450 250, 490 180 S 560 260, 600 70" fill="none" stroke="#fb923c" stroke-width="5" stroke-linecap="round" />
                <text x="530" y="60" fill="#fca5a5" font-size="18" font-weight="800">DIVERGED!</text>
                <text x="480" y="316" fill="#94a3b8" font-size="13">batches →</text>
              </g>
            ) : simulation.demo === 'mcts' ? (
              <g font-family="system-ui, sans-serif" text-anchor="middle">
                <text x="320" y="40" fill="#c4b5fd" font-size="16">SELECT → EXPAND → SIMULATE → BACK UP</text>
                <path d="M320 100 L150 215 M320 100 L490 215" stroke="#64748b" stroke-width="4" fill="none" />
                <path d="M320 100 L320 215 L320 300" stroke="#c4b5fd" stroke-width="5" fill="none" />
                {[[320, 100, '3/5'], [150, 215, '0/1'], [320, 215, '2/2'], [490, 215, '1/2']].map(([x, y, label]) => (
                  <g><circle cx={x} cy={y} r="37" fill="#c6def0" /><text x={x} y={Number(y) + 8} fill="#102032" font-size="24">{label}</text></g>
                ))}
                <circle cx="320" cy="300" r="22" fill="#bbf7d0" />
                <text x="320" y="307" fill="#102032" font-size="20">+1</text>
              </g>
            ) : simulation.demo === 'gridworld' ? (
              <g font-family="system-ui, sans-serif">
                <text x="46" y="48" fill="#c6ef85" font-size="14">VALUE → POLICY</text>
                {[0, 1, 2, 3].map((state) => (
                  <g transform={`translate(${46 + state % 2 * 130} ${70 + Math.floor(state / 2) * 120})`}>
                    <rect width="118" height="108" rx="10" fill={state === 3 ? '#263d30' : '#284344'} stroke="#55716a" />
                    <text x="12" y="22" fill="#a4b5ba" font-size="12">s{state}</text>
                    <text x="59" y="62" text-anchor="middle" fill="#edf3f1" font-size="28">{['−2', '−1', '−1', '★'][state]}</text>
                    <text x="59" y="90" text-anchor="middle" fill="#c6ef85" font-size="21">{['→', '↓', '→', '0'][state]}</text>
                  </g>
                ))}
                <text x="342" y="128" fill="#a4b5ba" font-size="13">BELLMAN BACKUP</text>
                <text x="342" y="173" fill="#edf3f1" font-size="22">V(s) ← max Q(s,a)</text>
                <text x="342" y="219" fill="#c6ef85" font-size="14">KNOWN MODEL</text>
                <text x="342" y="245" fill="#a4b5ba" font-size="14">One state at a time.</text>
              </g>
            ) : simulation.demo === 'td0-to-td1' ? (
              <g font-family="system-ui, sans-serif">
                <text x="46" y="48" fill="#94a3b8" font-size="14">RMS ERROR · SAME EPISODES</text>
                <line x1="46" y1="292" x2="400" y2="292" stroke="#475569" stroke-width="2" />
                <line x1="46" y1="70" x2="46" y2="292" stroke="#475569" stroke-width="2" />
                <path d="M46 82 C 110 140, 170 205, 230 238 S 340 252, 400 248" fill="none" stroke="#60a5fa" stroke-width="5" stroke-linecap="round" />
                <path d="M46 82 C 70 160, 95 205, 130 214 S 260 196, 400 202" fill="none" stroke="#fb923c" stroke-width="5" stroke-linecap="round" />
                <text x="46" y="318" fill="#94a3b8" font-size="13">episodes →</text>
                <g transform="translate(436 78)">
                  <rect width="160" height="190" rx="18" fill="#0f172a" stroke="#334155" stroke-width="2" />
                  <text x="20" y="34" fill="#94a3b8" font-size="13">STREAMS</text>
                  <circle cx="28" cy="70" r="8" fill="#60a5fa" />
                  <text x="44" y="77" fill="#f8fafc" font-size="22" font-weight="700">n = 1</text>
                  <circle cx="28" cy="114" r="8" fill="#fb923c" />
                  <text x="44" y="121" fill="#f8fafc" font-size="22" font-weight="700">n = 4</text>
                  <text x="20" y="164" fill="#d9ff62" font-size="14" font-weight="700">TD(0) ⟷ MC</text>
                </g>
              </g>
            ) : (<g>
            <g transform="translate(54 50)">
              <text x="0" y="0" fill="#94a3b8" font-size="15" font-family="system-ui, sans-serif">
                ESTIMATED REWARD
              </text>

              <g transform="translate(0 34)">
                <line x1="0" y1="202" x2="340" y2="202" stroke="#475569" stroke-width="2" />
                <rect x="16" y="122" width="42" height="80" rx="8" fill="#334155" />
                <rect x="84" y="92" width="42" height="110" rx="8" fill="#475569" />
                <rect x="152" y="44" width="42" height="158" rx="8" fill={`url(#gallery-reward-${simulation.demo})`} />
                <rect x="220" y="108" width="42" height="94" rx="8" fill="#334155" />
                <rect x="288" y="76" width="42" height="126" rx="8" fill="#475569" />

                <circle cx="173" cy="27" r="12" fill="#d9ff62" />
                <path d="M166 27l5 5 9-11" fill="none" stroke="#172033" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />

                <text x="37" y="226" text-anchor="middle" fill="#94a3b8" font-size="13" font-family="system-ui, sans-serif">1</text>
                <text x="105" y="226" text-anchor="middle" fill="#94a3b8" font-size="13" font-family="system-ui, sans-serif">2</text>
                <text x="173" y="226" text-anchor="middle" fill="#d9ff62" font-size="13" font-weight="700" font-family="system-ui, sans-serif">3</text>
                <text x="241" y="226" text-anchor="middle" fill="#94a3b8" font-size="13" font-family="system-ui, sans-serif">4</text>
                <text x="309" y="226" text-anchor="middle" fill="#94a3b8" font-size="13" font-family="system-ui, sans-serif">5</text>
              </g>
            </g>

            <g transform="translate(430 88)">
              <rect width="158" height="166" rx="18" fill="#0f172a" stroke="#334155" stroke-width="2" />
              <text x="20" y="34" fill="#94a3b8" font-size="13" font-family="system-ui, sans-serif">EXPLORATION</text>
              <text x="20" y="75" fill="#f8fafc" font-size="32" font-weight="750" font-family="system-ui, sans-serif">ε = 0.10</text>
              <line x1="20" y1="104" x2="138" y2="104" stroke="#334155" stroke-width="8" stroke-linecap="round" />
              <line x1="20" y1="104" x2="72" y2="104" stroke="#67e8f9" stroke-width="8" stroke-linecap="round" />
              <circle cx="72" cy="104" r="11" fill="#f8fafc" stroke="#67e8f9" stroke-width="4" />
              <text x="20" y="142" fill="#d9ff62" font-size="14" font-weight="700" font-family="system-ui, sans-serif">EXPLOIT BEST ARM</text>
            </g>
            </g>)}
          </svg>
          <span class="play-mark">
            <svg viewBox="0 0 24 24" role="presentation">
              <path d="M8.5 6.5v11l9-5.5-9-5.5Z" fill="currentColor" />
            </svg>
          </span>
        </div>

        <div class="simulation-copy">
          <span class="simulation-topic">{simulation.topic}</span>
          <h2>{simulation.title}</h2>
          <p>{simulation.description}</p>
          <span class="simulation-action">Launch simulation <span aria-hidden="true">→</span></span>
        </div>
      </a>
    ))
  }
</div>

<style>
  .simulation-gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 23rem));
    gap: 1.35rem;
    margin: 1.5rem 0 2.5rem;
  }

  .simulation-card {
    display: block;
    overflow: hidden;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.8rem;
    background: var(--sl-color-gray-7);
    color: inherit;
    text-decoration: none;
    box-shadow: 0 0.3rem 1.1rem rgb(0 0 0 / 9%);
  }

  .simulation-card:hover {
    border-color: var(--sl-color-accent-high);
    color: inherit;
  }

  .simulation-card:focus-visible {
    outline: 3px solid var(--sl-color-accent-high);
    outline-offset: 3px;
  }

  .simulation-thumbnail {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    background: #101a33;
  }

  .simulation-thumbnail > svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .play-mark {
    position: absolute;
    right: 0.9rem;
    bottom: 0.9rem;
    display: grid;
    width: 2.65rem;
    height: 2.65rem;
    place-items: center;
    border: 1px solid rgb(255 255 255 / 28%);
    border-radius: 50%;
    background: rgb(15 23 42 / 82%);
    color: #d9ff62;
    backdrop-filter: blur(8px);
  }

  .play-mark svg {
    width: 1.35rem;
    height: 1.35rem;
  }

  .simulation-copy {
    padding: 1rem 1.1rem 1.15rem;
  }

  .simulation-topic {
    color: var(--sl-color-accent-high);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .simulation-copy h2 {
    margin: 0.28rem 0 0;
    color: var(--sl-color-white);
    font-size: 1.25rem;
    line-height: 1.3;
  }

  .simulation-copy p {
    margin: 0.55rem 0 1rem;
    color: var(--sl-color-gray-2);
    font-size: 0.88rem;
    line-height: 1.55;
  }

  .simulation-action {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--sl-color-accent-high);
    font-size: 0.82rem;
    font-weight: 750;
  }

  .simulation-action span {
    transition: transform 150ms ease;
  }

  @media (prefers-reduced-motion: no-preference) {
    .simulation-card {
      transition: transform 160ms ease, border-color 160ms ease, box-shadow 160ms ease;
    }

    .simulation-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 0.7rem 1.6rem rgb(0 0 0 / 14%);
    }

    .simulation-card:hover .simulation-action span {
      transform: translateX(0.2rem);
    }
  }
</style>
