---
/**
 * Embeds a standalone demo inside a chapter page.
 *
 * This is the ONLY place a demo URL is constructed. Astro does not prefix
 * root-absolute links with `base`, so a hand-written `/demos/...` href works in
 * dev and 404s on GitHub Pages. Routing every embed through here means no page
 * can reintroduce that bug.
 */
import { demoUrl, sourceUrl } from '../lib/url';

interface Props {
  /** Chapter directory, e.g. "multi-armed-bandits". */
  chapter: string;
  /** Demo slug, e.g. "epsilon-greedy". */
  demo: string;
  /** Accessible title for the iframe. */
  title: string;
  /** Repo-relative path to the demo's source, for the View source link. */
  source?: string;
  /** Iframe height. Demos are responsive, so this is a starting point. */
  height?: string;
  /** Query string appended to the demo URL, without the leading "?". */
  query?: string;
  /**
   * Resize the iframe to the demo's content. The demo posts
   * `{ type: 'gpu-lab-height', height }`; only messages from this iframe count.
   */
  autoHeight?: boolean;
  /** Text of the full-screen link. */
  fullLabel?: string;
}

const { chapter, demo, title, source, query, autoHeight = false, fullLabel = 'Open demo full screen ↗' } = Astro.props;
const height = Astro.props.height ?? (autoHeight ? '640px' : '780px');
const base = demoUrl(chapter, demo);
const href = query ? `${base}?${query}` : base;
---

<figure class="demo-frame">
  <iframe
    src={href}
    title={title}
    height={height}
    loading="lazy"
    data-auto-height={autoHeight ? '' : undefined}
  ></iframe>
  <figcaption>
    <a href={base} target="_blank" rel="noopener">{fullLabel}</a>
    {source && <a href={sourceUrl(source)} target="_blank" rel="noopener">View source ↗</a>}
  </figcaption>
</figure>

{autoHeight && (
  <script is:inline>
    (() => {
      if (window.__demoAutoHeight) return;
      window.__demoAutoHeight = true;
      const MIN = 320;
      const MAX = 4000;
      window.addEventListener('message', (event) => {
        const data = event.data;
        if (!data || data.type !== 'gpu-lab-height' || typeof data.height !== 'number') return;
        for (const frame of document.querySelectorAll('iframe[data-auto-height]')) {
          if (frame.contentWindow && event.source === frame.contentWindow) {
            frame.style.height = `${Math.min(MAX, Math.max(MIN, Math.ceil(data.height)))}px`;
          }
        }
      });
    })();
  </script>
)}

<style>
  .demo-frame {
    margin: 1.5rem 0;
  }

  .demo-frame iframe {
    width: 100%;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    background: #0f172a;
    display: block;
  }

  .demo-frame figcaption {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 0.5rem;
    font-size: 0.875rem;
  }
</style>
